# =====================================================
# AI Travel Planner - Environment Configuration
# =====================================================
#
# Copy this file to:
#
#   .env
#
# Then add your real secret values.
#
# NEVER commit your real .env file to GitHub.
# =====================================================

# Gemini / LLM
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-flash-lite-latest
TEMPERATURE=0.2

# Weather
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT=15

# Maps / Routing
MAPS_GEOCODING_URL=https://nominatim.openstreetmap.org/search
MAPS_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
MAPS_USER_AGENT=AI_Travel_Planner/1.0
MAPS_REQUEST_TIMEOUT=15

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3
